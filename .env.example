# ---- Copy this file to .env and fill in real values. NEVER commit .env ----

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (Phase 0)
# Get from: MongoDB Atlas > Cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mv_cleaning?retryWrites=true&w=majority

# JWT signing (Phase 1) — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# MSG91 SMS OTP (Phase 1)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Razorpay (Phase 2 / 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS — comma-separated allowed origins (admin panel URL)
CORS_ORIGINS=http://localhost:5173
