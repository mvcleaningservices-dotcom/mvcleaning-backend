# ---- Copy this file to .env and fill in real values. NEVER commit .env ----

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (Phase 0)
# Get from: MongoDB Atlas > Cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mv_cleaning?retryWrites=true&w=majority

# JWT signing (Phase 1) — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret
JWT_CONSUMER_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=1d

# Initial Super Admin (Phase 1) — seeded on first boot if no super admin exists.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_this_strong_password

# Omnichannel SMS OTP (STPL-registered, DLT-compliant)
# TODO: fill in once credentials and domain are confirmed.
SMS_DOMAIN=
SMS_USERNAME=mvcleaning.trans
SMS_PASSWORD=
SMS_SENDER_ID=MVCLSS
SMS_DLT_CONTENT_ID=1777179085282340380

# Razorpay (Phase 2 / 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS — comma-separated allowed origins (admin panel URL)
CORS_ORIGINS=http://localhost:5173

# Cloudinary (image hosting/CDN) — get from cloudinary.com > Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
